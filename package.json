{
  "name": "@local/dsh-raccoon",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Left-sidebar Raccoon (商汤小浣熊) panel for credits and the model catalog, plus an OpenAI-compatible endpoint for the custom model API.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/uia040808-design/dsh-connect-sensetime.git"
  },
  "homepage": "https://github.com/uia040808-design/dsh-connect-sensetime#readme",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "README.md",
    "locale/*.json",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
